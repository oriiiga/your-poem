# 复制为 .env.local 并填入你自己的配置（Vercel 上在项目 Settings → Environment Variables 配置同名变量）

# 公网 LLM 接口密钥（必填才会启用公网 AI 生词通道）
# 智谱开放平台: https://open.bigmodel.cn  → 免费模型 glm-4-flash
# DeepSeek:     https://platform.deepseek.com → 模型填 deepseek-chat，BASE_URL 填 https://api.deepseek.com
LLM_API_KEY=

# OpenAI 兼容接口地址（选填，默认智谱）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名（选填，默认 glm-4-flash）
LLM_MODEL=glm-4-flash
